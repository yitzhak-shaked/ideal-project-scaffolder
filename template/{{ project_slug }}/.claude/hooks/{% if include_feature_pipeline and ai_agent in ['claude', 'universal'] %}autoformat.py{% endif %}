#!/usr/bin/env python3
"""PostToolUse best-effort formatter for the file an agent just edited.

Never blocks: always exits 0. Skips silently when the formatter is not
installed. Covers the languages this scaffolder supports.
"""
import json
import os
import shutil
import subprocess
import sys

FORMATTERS = {
    ".py": [["ruff", "format"], ["ruff", "check", "--fix"]],
    ".rs": [["rustfmt"]],
    ".c": [["clang-format", "-i"]],
    ".cc": [["clang-format", "-i"]],
    ".cpp": [["clang-format", "-i"]],
    ".cxx": [["clang-format", "-i"]],
    ".h": [["clang-format", "-i"]],
    ".hpp": [["clang-format", "-i"]],
    ".hh": [["clang-format", "-i"]],
    ".ts": [["npx", "--no-install", "prettier", "--write"]],
    ".tsx": [["npx", "--no-install", "prettier", "--write"]],
    ".js": [["npx", "--no-install", "prettier", "--write"]],
}


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        sys.exit(0)

    tool_input = payload.get("tool_input") or {}
    path = tool_input.get("file_path") or tool_input.get("path") or ""
    if not path or not os.path.exists(path):
        sys.exit(0)

    ext = os.path.splitext(path)[1].lower()
    for cmd in FORMATTERS.get(ext, []):
        if shutil.which(cmd[0]) is None:
            continue
        try:
            subprocess.run(cmd + [path], capture_output=True, timeout=30)
        except Exception:
            pass  # formatting is best-effort; never fail the hook

    sys.exit(0)


if __name__ == "__main__":
    main()
